# What the CUDA 12 build takes (settings only, read by plan.sh). Bump REV in release.yml when this
# file or build.sh changes.
#
# The flavor it serves: gladiaio/gladia-enterprise's -cu128 inference images (inference/Dockerfile.unified
# CUDA_FLAVOR=cu128: NVIDIA driver >= 525). Their vLLM venvs (nemo-vllm for solaria-3, solaria-4)
# install this wheel on the torch CUDA 12 build it was compiled against.
FLAVOR=cu128

# torch's CUDA 12 builds, preferred first: the build compiles against the first one PyTorch's index
# has for the exact torch the vLLM release pins (torch 2.14.0: cu126 only; 2.13.0: cu126, cu129)
TORCH_CUDA_VARIANTS="cu129 cu128 cu126"

# the CUDA toolkit (nvidia/cuda:<toolkit>-cudnn-devel-ubuntu24.04) each variant compiles with: the
# same CUDA as torch's build, so vLLM's kernels and torch share one CUDA runtime
TOOLKIT_cu129=12.9.1
TOOLKIT_cu128=12.8.1
TOOLKIT_cu126=12.6.3

# compute capabilities, the GPUs a -cu128 vLLM venv runs on: T4 7.5, A100 8.0, A10G / A10 / A40 /
# RTX 30xx 8.6, L4 / L40S / RTX 40xx 8.9, H100 / H200 9.0, and Blackwell (B200 10.0, RTX PRO 6000
# 12.0) when the toolkit can target it (CUDA >= 12.8). V100 (7.0) runs no vLLM (the -volta venvs).
ARCHS_cu129="7.5 8.0 8.6 8.9 9.0 10.0 12.0"
ARCHS_cu128="7.5 8.0 8.6 8.9 9.0 10.0 12.0"
ARCHS_cu126="7.5 8.0 8.6 8.9 9.0"
